        '超材料', '超结构', '声学黑洞', '弹性波', '波调控', '带隙', '智能结构', '压电',
        '减振', '隔振', '非线性振动', '拓扑', '负泊松', '可编程', '变刚度', '能量俘获',
    ],
    'weak': [
        'mechanic', 'composite', 'laminate', 'shell', 'plate', 'membrane', 'beam',
        'vibration', 'wave', 'buckling', 'flutter', 'aerospace', 'aircraft', 'wing',
        'structural', 'microstructure', 'fatigue', 'fracture', 'impact', 'crashworthiness',
        'stiffness', 'damping', 'resonance', 'mode shape', 'optimization',
        '力学', '复合材料', '结构', '振动', '航空', '航天', '刚度', '阻尼', '优化',
    ],
}

# 每天的"合集/日报"类标题会占掉唯一一格的科普位，看到这些词直接跳过
EXCLUDE_TITLE = [
    'the download', 'week in review', 'roundup', 'newsletter', 'this week in',
    '每日', '周报', '合集', '汇总', '一览', '盘点',
]

# 章节标题 → 类别，供 parse_index 复原顺序（书里的章节顺序就是这里的顺序）
SECTION_ORDER = ['frontier', 'popular', 'broad', 'current']


class DailyScienceBrief(BasicNewsRecipe):
    title = '每日科学简报'
    description = '力学 / 智能结构 / 弹性波方向的前沿速递 + 科普 + 时事，每期 7 篇'
    __author__ = 'daily-brief'
    language = 'zho'                 # ISO-639；主体中文
    publication_type = 'newspaper'   # newspaper / magazine / blog
    timefmt = ' [%Y-%m-%d]'

    # ---- 抓取量控制 ----
    # 正常流程下篇数由 scripts/pick_articles.py 的 QUOTA 决定，这里只是兜底上限：
    # 万一 picked.json 不存在、退回 Calibre 原生抓 RSS，每源也最多 3 篇。
    max_articles_per_feed = 3
    oldest_article = 45.0            # 只取 45 天内的文章（pick 阶段已按类别各自过滤）
    remove_empty_feeds = True
    ignore_duplicate_articles = {'title', 'url'}
    simultaneous_downloads = 3
    timeout = 60.0

    # ---- 正文来源 ----
    # True = 用 RSS 自带的摘要/正文，不再去抓网页。
    # 期刊 RSS 给的就是完整摘要，够读；好处是不触发出版社反爬，本地一秒出书。
    # 想读全文改成 False（代价：慢，且遇到反爬会丢章节）。
    use_embedded_content = True

    # ---- 体积控制：邮件附件和 Kindle 传输都有大小限制 ----
    compress_news_images = True
    compress_news_images_max_size = 120   # 单张图片最大 120 KB
    scale_news_images = (800, 800)

    conversion_options = {
        'base_font_size': 13,
        'linearize_tables': True,
    }

    extra_css = 'body { line-height: 1.65; }\n' \
                'h1, h2, h3 { line-height: 1.3; }\n' \
                'img { max-width: 100%; }\n' \
                '.picked-meta { color: #666; font-size: 0.9em; }\n'

    # 兜底路径用的平铺清单（picked.json 存在时不会走到这里）
    feeds = [pair for group in SECTION_ORDER for pair in FEED_GROUPS[group]]

    # ---------------------------------------------------------------------
    # 真正的入口：读 pick_articles.py 写好的 build/picked.json
    # ---------------------------------------------------------------------
    def parse_index(self):
        path = os.environ.get('BRIEF_PICKED') or os.path.join('build', 'picked.json')
        if not os.path.exists(path):
            # 抛这个异常，Calibre 会退回 parse_feeds()，即按 self.feeds 直接抓 RSS
            print('!! 没找到 %s，退回 Calibre 原生逐源抓取' % path)
            raise NotImplementedError('no picked.json')

        with open(path, encoding='utf-8') as fh:
            data = json.load(fh)

        index = []
        for section in data.get('sections', []):
            articles = []
            for item in section.get('items', []):
                articles.append({
                    'title': item['title'],
                    'url': item['url'],
                    'author': item.get('author') or item.get('source') or '',
                    'date': ' [%s]' % item.get('date', ''),
                    'content': item.get('content') or '',
                    'description': item.get('content') or '',
                })
            if articles:
                index.append((section['title'], articles))

        if not index:
            print('!! %s 里没有任何条目，退回逐源抓取' % path)
            raise NotImplementedError('picked.json is empty')

        print('本期从 %s 读取选材结果，共 %d 篇' % (
            path, sum(len(a) for _, a in index)))
        return index
