# "合集/日报"类标题会白占一格配额，看到就跳过
EXCLUDE_TITLE = [
    'the download', 'week in review', 'roundup', 'newsletter', 'this week in',
    '每日', '周报', '合集', '汇总', '一览', '盘点',
]


class DailyScienceBrief(BasicNewsRecipe):
    title = '每日科学简报'          # 单大类的书由 ebook-convert --metadata-set 覆盖标题
    description = '力学 / 智能结构 / 弹性波方向的前沿速递 + 科普 + 时事'
    __author__ = 'daily-brief'
    language = 'zho'                 # ISO-639；主体中文
    publication_type = 'newspaper'   # newspaper / magazine / blog
    timefmt = ' [%Y-%m-%d]'

    # ---- 兜底路径的量控（正常流程篇数由 BOOKS 决定）----
    max_articles_per_feed = 3
    oldest_article = 45.0
    remove_empty_feeds = True
    ignore_duplicate_articles = {'title', 'url'}
    simultaneous_downloads = 3
    timeout = 60.0

    # ---- 正文来源 ----
    # True = 用 RSS 自带的摘要，不去抓网页。期刊 RSS 给的就是完整摘要，够读；
    # 正文页要么付费墙（Nature），要么直接反爬 403（ScienceDirect、Science），
    # 改成 False 也拿不到全文，只会白等超时。
    use_embedded_content = True

    # ---- 体积控制：邮件附件和 Kindle 传输都有大小限制 ----
    compress_news_images = True
    compress_news_images_max_size = 120
    scale_news_images = (800, 800)

    conversion_options = {
        'base_font_size': 13,
        'linearize_tables': True,
    }

    extra_css = 'body { line-height: 1.65; }\n' \
                'h1, h2, h3 { line-height: 1.3; }\n' \
                'img { max-width: 100%; }\n' \
                '.picked-meta { color: #666; font-size: 0.9em; }\n'

    # 兜底路径用的平铺清单（picked.json 存在时不会走到这里）
    feeds = [pair for key in SECTION_ORDER for pair in FEED_GROUPS[key]]

    # ---------------------------------------------------------------------
    # 真正的入口：读 build_brief.py 写好的 picked.json
    # ---------------------------------------------------------------------
    def parse_index(self):
        path = os.environ.get('BRIEF_PICKED') or os.path.join('build', 'picked.json')
        if not os.path.exists(path):
            print('!! 没找到 %s，退回 Calibre 原生逐源抓取' % path)
            # 抛这个异常，Calibre 会退回 parse_feeds()，即按 self.feeds 直接抓 RSS
            raise NotImplementedError('no picked.json')

        with open(path, encoding='utf-8') as fh:
            data = json.load(fh)

        # 一本书一个大类拼盘，书名跟着 picked.json 走（ebook-convert 没有
        # --metadata-set，配方又是同一个文件，只能在这里改 self.title）
        if data.get('book'):
            self.title = data['book']

        index = []
        for section in data.get('sections', []):
            articles = [{
                'title': item['title'],
                'url': item['url'],
                'author': item.get('author') or item.get('source') or '',
                'date': ' [%s]' % item.get('date', ''),
                'content': item.get('content') or '',
                'description': item.get('content') or '',
            } for item in section.get('items', [])]
            if articles:
                index.append((section['title'], articles))

        if not index:
            print('!! %s 里没有任何条目，退回逐源抓取' % path)
            raise NotImplementedError('picked.json is empty')

        print('本期《%s》从 %s 读取选材结果，共 %d 篇' % (
            data.get('book', self.title), path, sum(len(a) for _, a in index)))
        return index
