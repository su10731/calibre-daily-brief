# strong = 直接对口（这些命中一条就基本能入选）；weak = 沾边（用来在同类里排序）。
# ---------------------------------------------------------------------------
TOPIC_KEYWORDS = {
    'strong': [
        # 超材料 / 超结构 / 声学器件
        'metamaterial', 'meta-material', 'metastructure', 'meta-structure', 'metasurface',
